---
/**
 * The landing page.
 *
 * Lifted out of `index.html` by #113 with the body markup untouched: the
 * head moved into `Base`, the header and footer into components, the
 * stylesheet into `src/styles/site.css`, and what is left here is exactly
 * the `<main>` that was already shipping.
 *
 * The script stays `is:inline` deliberately. Astro would otherwise hoist
 * and bundle it as a module, which is very probably equivalent and is
 * exactly the kind of "very probably" a no-visible-change migration should
 * not be spending. It is plain DOM code against `.rail`; it can become a
 * proper island when something asks it to.
 *
 * The waitlist closed on 2026-10-02, the day the app went live on Google Play.
 * Both signup forms became the store badge, and every waitlist button
 * became a link to the listing. `api/waitlist.js` is left standing but
 * unlinked; `src/lib/stores.test.ts` fails if a page points at it again.
 *
 * The reviews section is the one place on the site that loads a script we did
 * not write. It is SaaS Browser's carousel, rendered from their profile id
 * into `#saas-browser-reviews`, and it sits above the plans because social
 * proof is worth more before the price than after it. The markup is their
 * snippet unchanged: the div, the verified link, the `async` tag, in that
 * order. Only the frame around it is ours, in `site.css`. It is a third-party
 * processor of whatever a browser sends when it fetches a file, which is why
 * `docs/privacy-policy.md` names it under **The website**.
 */
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StoreBadge from '../components/StoreBadge.astro';
import { PLAY_URL } from '../lib/stores';

const TITLE = 'Flintroom: the room that grills you before the room that matters';
const DESCRIPTION =
  'Practice against a panel of AI interrogators that challenges your argument off your own material, then a coach who rebuilds the answers that broke. Out now on Android.';
const OG_DESCRIPTION =
  'A panel of AI interrogators challenges your argument off your own material, then a coach rebuilds the answers that broke. Out now on Android.';
---

<Base title={TITLE} description={DESCRIPTION} ogDescription={OG_DESCRIPTION} url="https://www.flintroom.app/">

<Header />

<main id="top">

  <section class="hero">
    <div class="bloom" aria-hidden="true"></div>
    <div class="shell split">
      <div>
        <div class="chips">
          <span class="chip">Out now</span>
          <span class="open">On Android</span>
        </div>
        <h1>Hold your argument <em>before the room that matters.</em></h1>
        <p class="sub">Practice against a panel of AI interrogators built to challenge, interrupt, and press. They quote your own slides back at you. Never walk into a high-stakes meeting unprepared again.</p>
        <StoreBadge />
      </div>

      <aside class="phones" aria-label="Flintroom on a phone: setting the room, then the live interrogation">
        <img class="phone back" src="/shots/set.jpg" width="688" height="1400"
             alt="The Set the room screen: a deck attached and read, a sentence about the audience, and two panelists seated">
        <img class="phone front" src="/shots/room.jpg" width="688" height="1400"
             alt="A live interrogation: the Technical Skeptic asking a question, the clock at 0:04 of 12:00, the room reading Skeptical">
      </aside>
    </div>
  </section>

  <section class="band" aria-label="Situations Flintroom is built for">
    <div class="shell">
      <p class="label">Built for the rooms that matter</p>
      <ul>
        <li>Board readouts</li>
        <li>Budget defenses</li>
        <li>Client renewals</li>
        <li>Thesis defense</li>
        <li>Demo day</li>
      </ul>
    </div>
  </section>

  <section class="features" id="how">
    <div class="shell">
      <h2>Pressure first. Teaching second.</h2>
      <p class="sub">Other tools score your delivery. Flintroom attacks your substance, against your own material, and then rebuilds the answers that broke.</p>
      <div class="trio">
        <article class="feat">
          <span class="glyph"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10v4"/><path d="M8 7v10"/><path d="M12 4v16"/><path d="M16 7v10"/><path d="M20 10v4"/></svg></span>
          <h3>The interrogation</h3>
          <p>A live, voice-driven panel that interrupts, digs deeper, and presses on what you dodge. Attach your deck and every challenge cites a slide or something you said.</p>
          <div class="foot">
            <div class="gauge"><i></i></div>
            <p class="gauge-label">Room temperature: Skeptical</p>
          </div>
        </article>
        <article class="feat">
          <span class="glyph"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12a8 8 0 1 0-3.1 6.3L21 20l-.9-3.4A7.9 7.9 0 0 0 21 12z"/></svg></span>
          <h3>The debrief</h3>
          <p>When the pressure stops, a coach ranks the answers that came loose and spars with you until each one holds. Unlimited, unmetered, and never a scorecard.</p>
          <div class="foot tags">
            <span class="tag">Worst first</span>
            <span class="tag quiet">Never graded</span>
          </div>
        </article>
        <article class="feat">
          <span class="glyph"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 17l6-6 4 4 8-8"/><path d="M15 7h6v6"/></svg></span>
          <h3>Progress</h3>
          <p>Every room is kept: the transcript, the recording, the findings. Run the same argument again and watch the questions that used to break it stop landing.</p>
          <div class="foot">
            <svg class="trend" viewBox="0 0 240 56" preserveAspectRatio="none" aria-hidden="true">
              <line class="grid" x1="0" y1="48" x2="240" y2="48"/>
              <line class="grid" x1="0" y1="28" x2="240" y2="28"/>
              <line class="grid" x1="0" y1="8" x2="240" y2="8"/>
              <polyline points="4,46 44,40 84,42 124,30 164,24 204,14 236,10"/>
              <circle cx="236" cy="10" r="3"/>
            </svg>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="board" id="board">
    <div class="shell">
      <div class="head">
        <div>
          <h2>Meet your panel</h2>
          <p>Eight archetypes, each with their own priorities, blind spots, and way of pressing. Every room mixes support with hostility, because a uniformly hostile room teaches less than a real one.</p>
        </div>
      </div>
      <div class="rail" aria-label="The eight archetypes">
        <figure class="seat"><img src="/portraits/cfo.webp" alt="Portrait of The CFO archetype" loading="lazy"><figcaption class="id"><b>The CFO</b><span>Margins / Arithmetic</span></figcaption></figure>
        <figure class="seat"><img src="/portraits/technical_skeptic.webp" alt="Portrait of The Technical Skeptic archetype" loading="lazy"><figcaption class="id"><b>The Technical Skeptic</b><span>Tech / Architecture</span></figcaption></figure>
        <figure class="seat"><img src="/portraits/growth_maximalist.webp" alt="Portrait of The Growth Maximalist archetype" loading="lazy"><figcaption class="id"><b>The Growth Maximalist</b><span>Growth / Scale</span></figcaption></figure>
        <figure class="seat"><img src="/portraits/champion.webp" alt="Portrait of The Champion archetype" loading="lazy"><figcaption class="id"><b>The Champion</b><span>On your side</span></figcaption></figure>
        <figure class="seat"><img src="/portraits/risk_officer.webp" alt="Portrait of The Risk Officer archetype" loading="lazy"><figcaption class="id"><b>The Risk Officer</b><span>Compliance / Legal</span></figcaption></figure>
        <figure class="seat"><img src="/portraits/internal_blocker.webp" alt="Portrait of The Internal Blocker archetype" loading="lazy"><figcaption class="id"><b>The Internal Blocker</b><span>Operations / Status quo</span></figcaption></figure>
        <figure class="seat"><img src="/portraits/distracted_executive.webp" alt="Portrait of The Distracted Executive archetype" loading="lazy"><figcaption class="id"><b>The Distracted Executive</b><span>High level / Impatient</span></figcaption></figure>
        <figure class="seat"><img src="/portraits/customer_advocate.webp" alt="Portrait of The Customer Advocate archetype" loading="lazy"><figcaption class="id"><b>The Customer Advocate</b><span>Users / Experience</span></figcaption></figure>
      </div>
      <p class="more">Or write your own. Custom archetypes sit beside ours, shaped by a sentence about the room you are actually facing.</p>
    </div>
  </section>

  <section class="reviews" id="reviews">
    <div class="shell">
      <h2>Reviews</h2>
      <div id="saas-browser-reviews"></div>
      <p class="source"><a href="https://saasbrowser.com/en/saas/1646709/flintroom">We're verified on SaaS Browser</a></p>
    </div>
    <script is:inline src="https://assets.saasbrowser.com/widgets/display.min.js" data-profile="1a49ab0c-9997-4d8d-93e8-4079265a5495" data-layout="carousel" data-mode="light" async></script>
  </section>

  <section class="pricing" id="pricing">
    <div class="shell">
      <h2>Time under fire, priced plainly.</h2>
      <p class="sub">You pay for live interrogation minutes. The debrief and sparring that follow every room are unlimited on every plan, because the teaching should never be on a clock.</p>
      <div class="plans">
        <article class="plan">
          <h3>Free</h3>
          <p class="price"><b>$0</b></p>
          <p class="time">15 minutes of interrogation</p>
          <ul>
            <li><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>One complete session, start to prep sheet</li>
            <li><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>Unlimited debrief and sparring</li>
            <li><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>Attach a deck, face the full panel</li>
          </ul>
          <a class="btn ghost" href={PLAY_URL}>Start free on Android</a>
        </article>
        <article class="plan star">
          <p class="flag">Most rooms</p>
          <h3>Starter</h3>
          <p class="price"><b>$29</b><span>/ month</span></p>
          <p class="time">90 minutes of interrogation, monthly</p>
          <ul>
            <li><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>A real month of work: rough run, fix rounds, final pass</li>
            <li><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>Unlimited debrief and sparring</li>
            <li><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>Every room kept: transcript, recording, findings</li>
          </ul>
          <a class="btn" href={PLAY_URL}>Get it on Google Play</a>
        </article>
        <article class="plan">
          <h3>Pro</h3>
          <p class="price"><b>$59</b><span>/ month</span></p>
          <p class="time">3 hours of interrogation, monthly</p>
          <ul>
            <li><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>Room for several arguments in flight at once</li>
            <li><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>Everything in Starter</li>
            <li><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>Longest recording retention</li>
            <li><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>Custom archetypes, written by you</li>
            <li><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>Priority voice at peak hours</li>
          </ul>
          <a class="btn ghost" href={PLAY_URL}>Get it on Google Play</a>
        </article>
      </div>
      <p class="fine">Run out mid-month? Top-ups from $9, and minutes you buy never expire.</p>
    </div>
  </section>

  <section class="cta" id="get">
    <div class="shell inner">
      <img class="mark" src="/mark.png" alt="">
      <h2>Ready to own the room?</h2>
      <p>Stop practicing in the mirror. Start answering to people who push back. Your first room is free.</p>
      <StoreBadge />
    </div>
  </section>

</main>

<Footer />

<script is:inline>
  // The board turns slowly on its own — one seat every few seconds, wrapping
  // at the end. A touch or a scroll of your own parks it for a while, and
  // reduced-motion turns it off entirely: the rail still scrolls by hand.
  {
    const rail = document.querySelector(".rail");
    const still = matchMedia("(prefers-reduced-motion: reduce)");
    let parked = 0;
    for (const sign of ["pointerdown", "wheel", "touchstart"]) {
      rail.addEventListener(sign, () => { parked = Date.now() + 8000; }, { passive: true });
    }
    setInterval(() => {
      if (still.matches || Date.now() < parked || rail.scrollWidth <= rail.clientWidth) return;
      const step = rail.querySelector(".seat").getBoundingClientRect().width + 20;
      const atEnd = rail.scrollLeft + rail.clientWidth >= rail.scrollWidth - 8;
      rail.scrollTo({ left: atEnd ? 0 : rail.scrollLeft + step, behavior: "smooth" });
    }, 3000);
  }
</script>

</Base>
