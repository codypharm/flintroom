---
/**
 * The shape every free tool page shares.
 *
 * The page's own content is the slot. What this adds is the furniture that has
 * to be identical across all of them: the site header, the one conversion
 * block, the sideways links to the other tools, and the footer.
 *
 * The conversion block is last on purpose and there is only one (#113 decision
 * 4). A tool page that opens with a pitch is a marketing page wearing a
 * calculator, and nobody links to those.
 */
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { TOOLS } from '../lib/tools';
import '../styles/tools.css';

interface Props {
  title: string;
  description: string;
  url: string;
  /** Omitted on the hub, which is not itself a tool. */
  current?: string;
}

const { title, description, url, current } = Astro.props;

// Where you are, and the way back. The only route off a tool page was the
// brand mark or the nav item, neither of which says what you would be going
// back to — and a visitor who arrived from a search has no history to use.
//
// A breadcrumb, not a kicker. The distinction matters: a kicker is decorative
// label text restating the heading's category, and the craft floor bans it
// outright. These are links, and the last one is where you actually are.
const here = current ? TOOLS.find((tool) => tool.href === current) : undefined;
const crumbs = [
  { href: '/', name: 'Flintroom' },
  { href: '/tools', name: 'Free tools' },
  ...(here ? [{ href: here.href, name: here.name }] : []),
];
// Only on a tool page. The hub already lists every tool as its content, and
// without the `current` guard it listed them a second time under "Other free
// tools" — the same links, twice, on a page with one link.
const others = current ? TOOLS.filter((tool) => tool.href !== current) : [];
---

<Base title={title} description={description} url={url}>
  <Header />

  <main id="top">
    <nav class="crumbs" aria-label="Breadcrumb">
      <div class="shell">
        <ol>
          {crumbs.map((crumb, index) => {
            const last = index === crumbs.length - 1;
            return (
              <li>
                {last
                  ? <span aria-current="page">{crumb.name}</span>
                  : <a href={crumb.href}>{crumb.name}</a>}
                {!last && <span class="sep" aria-hidden="true">/</span>}
              </li>
            );
          })}
        </ol>
      </div>
    </nav>

    <slot />

    <section class="tool-cta">
      <div class="shell">
        <div class="inner">
          <h2>A number is only as good as your answer about it.</h2>
          <p>
            Flintroom is a rehearsal room. A panel of AI interrogators presses on your argument
            out loud, quotes your own deck back at you, and does not accept the first answer.
            Then a coach rebuilds the ones that came loose.
          </p>
          <a class="btn" href="/#waitlist">Join the waitlist</a>
        </div>
      </div>
    </section>

    {others.length > 0 && (
      <section class="siblings">
        <div class="shell">
          <h2>Other free tools</h2>
          <ul>
            {others.map((tool) => (
              <li>
                <a href={tool.href}>
                  <b>{tool.name}</b>
                  <span>{tool.blurb}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <div class="tool-foot"></div>
  </main>

  {here && (
    <!-- What this page IS, for a machine that has to decide whether to
         recommend it. The prose already says free, browser-based and
         no-signup; this states the same three facts in a form that is parsed
         rather than inferred, which is the whole difference between a reader
         and a retriever.

         `WebApplication` rather than `SoftwareApplication`: it is the narrower
         subtype and it is true — these run in the page and install nothing.
         Only on a tool page, because the hub is a list of them and the layout
         is shared. -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebApplication',
      name: here.name,
      description: here.blurb,
      url: `https://www.flintroom.app${here.href}`,
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      publisher: {
        '@type': 'Organization',
        name: 'Flintroom',
        url: 'https://www.flintroom.app/',
      },
    })} />
  )}

  <!-- The same trail, for the search result. `BreadcrumbList` is one of the
       few structured-data types Google still renders, and it replaces the raw
       URL under the title with the path a reader can parse. -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((crumb, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: crumb.name,
      item: `https://www.flintroom.app${crumb.href === '/' ? '' : crumb.href}`,
    })),
  })} />

  <Footer />
</Base>
