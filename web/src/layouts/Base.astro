---
/**
 * Every page's head, in one place.
 *
 * The migration this file belongs to (#113) was deliberately a no-op for
 * visitors: what lands here is exactly the markup `index.html` already
 * carried, lifted so the second page does not have to copy it. The only
 * edits are the two asset paths, which were relative (`mark.png`) and are
 * now root-relative (`/mark.png`) — identical from `/`, and the difference
 * between working and not once a page lives at `/tools/something`.
 *
 * `site.css` is imported here rather than inlined per page. It is the
 * landing page's stylesheet moved verbatim, still in its original order,
 * because splitting 250 lines of hand-written CSS into layout-and-page
 * halves reorders the cascade, and a migration whose whole promise is
 * "nothing changed" cannot also be the change that reorders the cascade.
 * Split it when a tool page shows which half it actually needs.
 */
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
  /** Absolute URL of this page. Canonical and `og:url` both want it. */
  url: string;
  /** Social title, which is allowed to differ from the tab's. */
  ogTitle?: string;
  ogDescription?: string;
}

const { title, description, url, ogTitle, ogDescription } = Astro.props;
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="theme-color" content="#fdf9f6">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Flintroom">
<meta property="og:title" content={ogTitle ?? title}>
<meta property="og:description" content={ogDescription ?? description}>
<meta property="og:url" content={url}>
<meta property="og:image" content="https://www.flintroom.app/og.jpg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<link rel="canonical" href={url}>
<link rel="icon" href="/mark.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
<slot />
</body>
</html>
