# Copy to `.env` and fill in. Never commit the result — `.gitignore` covers
# `.env` and `.env.*`, and this file is the one exception to that rule.
#
# Read from the process environment first and this file second, so a deployment
# that sets real environment variables does not need the file at all. The path
# is relative to the working directory, which is why the API is started from
# `backend/` rather than from the repository root.

# --- Required. The process refuses to boot without these. ---

# Postgres. `postgresql+asyncpg://` — the driver is async, and a `postgresql://`
# URL will be rejected by SQLAlchemy rather than silently fall back.
# Supabase is the host, not the platform: this is an ordinary connection string
# and nothing else in the app holds a Supabase credential.
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/flintroom

# Signs our own access tokens. At least 32 bytes — below that the key is weaker
# than HMAC-SHA256 itself and can be brute-forced offline by anyone holding one
# token, so the length is enforced at startup rather than warned about.
# Generate with: openssl rand -base64 48
# Per environment, never shared. Two deployments with one secret can forge
# tokens for each other.
JWT_SECRET=

# The `aud` values provider tokens are pinned to. Without pinning, a genuine
# Google token minted for somebody else's app would sign in here.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# --- Optional. Absent means the voice provider is unconfigured. ---

# Auth, balances and session bookkeeping all work without these, so the process
# starts and logs `voice_provider_unconfigured`. Only the stream socket refuses,
# and it refuses typed rather than crashing.
#
# The key is account-scoped: whoever holds it can read every conversation
# transcript and spend the balance. It belongs to a service account, not to a
# person — see task #12, which is blocked until the plan is paid.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# --- Optional. Absent means material ingestion is unconfigured. ---

# Where attached decks live. The endpoint is what makes this portable: the code
# speaks the S3 API and nothing else, so MinIO, AWS S3, Cloudflare R2 and
# Backblaze B2 differ only in these four lines.
#
# For local development, `docker compose up` provides all of it:
#   S3_ENDPOINT_URL=http://localhost:59000
#   S3_ACCESS_KEY_ID=flintroom
#   S3_SECRET_ACCESS_KEY=flintroom
#   S3_BUCKET=flintroom-material
#   S3_ADDRESSING_STYLE=path
#
# The endpoint has no default on purpose. A blank one that silently meant "the
# real AWS" would send credentials, and eventually somebody's deck, to a host
# nobody chose.
#
# All four or none: a bucket without a secret key builds a client that signs
# URLs the store rejects, so the failure appears as a 403 during upload rather
# than as a missing variable at boot.
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# SigV4 signs over a region whether or not the store has them. MinIO accepts
# anything; S3 does not. Defaulted, so only a real S3 deployment needs to set it.
# S3_REGION=us-east-1

# Where the bucket name goes: `virtual` puts it in the hostname, `path` puts it
# in the URL path. Defaults to `virtual` because AWS has said path-style URLs
# will be discontinued — indefinitely delayed since September 2020, so it still
# works, but not something to bake into production when a default will do.
#
# Set `path` for stores with no per-bucket DNS: MinIO locally, and Cloudflare
# R2, which documents path-style. AWS S3 needs nothing here.
# S3_ADDRESSING_STYLE=virtual

# --- Extraction ------------------------------------------------------------
#
# Reads an attached deck into claims. Optional, like the voice keys above: a
# deployment without it signs in users, tracks balances and runs the voice loop,
# and docs/auditor-grounding.md makes the deckless path first-class rather than
# degraded. Absent means material cannot be read; it is not a reason to refuse
# to boot.
ANTHROPIC_API_KEY=

# Which vendor. Only `claude` is implemented, and it is a Literal — a typo is a
# process that refuses to start rather than a deployment that quietly grounds
# nothing.
# EXTRACTION_PROVIDER=claude

# Which model within that vendor. The largest single lever on extraction cost,
# and every per-page figure in docs/ingestion.md rests on an unverified ~$0.01
# per page — so this is a decision to make against measured `extraction_costs`
# rows, not against the default below.
# EXTRACTION_MODEL=claude-sonnet-5

# How many model calls one deck may have in flight at once. A long deck is read
# in chunks of twenty pages — a 300-page deck is fifteen calls — and this bounds
# how many of them run together.
#
# Turn this DOWN if extraction starts logging `extraction_call_failed` with
# status 429. The rate-limit allowance is per organisation and shared by every
# user at once, not per account, so the ceiling is:
#
#   concurrent calls  =  ITPM x call_seconds / (55,000 x 60)
#
# At a low allowance and a fast call, four is already over the line with a
# single deck and nobody else on the system. It is a bet until a real deck has
# been timed, and it lives here so that losing the bet costs a config change
# rather than a deploy.
#
# The fleet's ceiling is this times the number of processes running the
# extraction loop, because each one holds exactly one deck at a time.
# EXTRACTION_CONCURRENT_CALLS=4

# Pages one account may extract in a rolling twenty-four hours. A circuit
# breaker against a loop, a bug or a script — not an entitlement, and uniform
# across tiers for that reason. The per-tier monthly budget lives in
# `billing/tiers.py`; this is the number to change by restarting rather than by
# shipping a release.
#
# It may never go below the largest per-file cap. Pro sells 300 pages a file,
# so a 200-page ceiling — the first value here — held the second upload of a
# deck somebody had just re-exported to fix a typo, which is not a runaway. Six
# hundred clears that twice over and is guarded in tests/test_material_limits.py.
#
# It only ever fires at pro. On the tighter tiers the monthly budget is lower
# and binds first, which is the order these controls should reach a runaway in.
DAILY_PAGE_CEILING=600

# Where headless LibreOffice is, which is a fact about the machine rather than a
# tuning knob. Left unset it is `soffice` on PATH, which is what both the
# Homebrew cask and the Debian package install.
#
# It is only reached for PPTX, and only to convert the file to PDF so it rejoins
# the PDF path — that is where the thumbnail and the page images come from, and
# a chart pasted into a slide as a screenshot has no XML for anything else to
# read. Without the binary, PPTX uploads fail as unreadable and PDFs and photos
# carry on working, which is the right way round but not one anybody will
# diagnose quickly. `libreoffice_missing` in the logs is the tell.
#
# A deck is written to a temporary directory to be converted, because the tool
# takes a path rather than a stream. It is removed on the way out, including on
# failure. Whatever this process's temporary directory is, it is somewhere
# confidential documents briefly exist.
# LIBREOFFICE_BINARY=soffice

# What RevenueCat signs its callbacks with — the signing secret from the webhook
# integration's HMAC settings, not the dashboard's plain Authorization header.
#
# Unset, the callback endpoint refuses *everything* with a 503 and records each
# refusal. That is deliberate and it is the safe direction: an endpoint that
# cannot verify but accepts anyway grants minutes to whoever finds the URL, while
# looking perfectly healthy. Purchases stop being credited instead — loudly — and
# RevenueCat's five retries deliver whatever arrived in the gap once it is set.
#
# Rotating it: set the new value in the dashboard and here in the same deploy.
# Signatures are checked against a five-minute window, so anything in flight
# during the swap is refused and retried rather than lost.
# REVENUECAT_WEBHOOK_SECRET=
